{
  "rubric_version": "2.0",
  "document_type": "Healthcare_Patient_Intake_Form",
  "extraction_criteria": [
    {
      "field_name": "patient_full_name",
      "syntactic_rules": {
        "required": true,
        "type": "string",
        "min_tokens": 2
      },
      "semantic_grounding_rules": {
        "source_section": "SECTION 1: PATIENT IDENTIFICATION",
        "verification_criteria": "Must match the patient's legal name. Do not extract preferred nicknames or abbreviated names if legal name is present.",
        "failure_modes": [
          "PREFERRED_NAME_CONFUSED_WITH_LEGAL",
          "NAME_TRUNCATED",
          "HALLUCINATION"
        ]
      }
    },
    {
      "field_name": "date_of_birth",
      "syntactic_rules": {
        "required": true,
        "type": "string",
        "format_regex": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "semantic_grounding_rules": {
        "source_section": "SECTION 1: PATIENT IDENTIFICATION",
        "verification_criteria": "Must match the patient's date of birth in YYYY-MM-DD format. Must not be confused with encounter/intake date, signature date, or coverage effective date.",
        "failure_modes": [
          "CONFUSED_WITH_ENCOUNTER_DATE",
          "FORMAT_MISMATCH",
          "HALLUCINATION"
        ]
      }
    },
    {
      "field_name": "social_security_number",
      "syntactic_rules": {
        "required": true,
        "type": "string",
        "format_regex": "^\\d{3}-\\d{2}-\\d{4}$",
        "masking_allowed": false
      },
      "semantic_grounding_rules": {
        "source_section": "SECTION 1: PATIENT IDENTIFICATION",
        "verification_criteria": "Must match verbatim the 9-digit Social Security Number from Section 1. Any digit transposition or altered numbers must trigger a failure.",
        "failure_modes": [
          "DIGIT_TRANSPOSITION",
          "HALLUCINATION",
          "FORMAT_MISMATCH"
        ]
      }
    },
    {
      "field_name": "residential_address",
      "syntactic_rules": {
        "required": true,
        "type": "object",
        "expected_subfields": [
          "street",
          "city",
          "state",
          "zip_code"
        ]
      },
      "semantic_grounding_rules": {
        "source_section": "SECTION 1: PATIENT IDENTIFICATION",
        "verification_criteria": "Must extract the patient's residential home address. Crucial: Must NOT extract clinic, hospital, or provider facility address.",
        "failure_modes": [
          "FACILITY_ADDRESS_CONFUSED_AS_PATIENT",
          "MISSING_SUITE_OR_APT",
          "WRONG_ZIP"
        ]
      }
    },
    {
      "field_name": "insurance_member_id",
      "syntactic_rules": {
        "required": true,
        "type": "string",
        "format_regex": "^[A-Z0-9\\-]+$"
      },
      "semantic_grounding_rules": {
        "source_section": "SECTION 2: PRIMARY INSURANCE DETAILS",
        "verification_criteria": "Must extract the primary insurance subscriber/member policy ID number. Must NOT confuse with Group Number, Payer ID, or Rx BIN numbers.",
        "failure_modes": [
          "CONFUSED_WITH_GROUP_NUMBER",
          "CONFUSED_WITH_PAYER_ID",
          "CHARACTER_ERROR"
        ]
      }
    },
    {
      "field_name": "primary_diagnosis_code",
      "syntactic_rules": {
        "required": true,
        "type": "string",
        "format_regex": "^[A-TV-Z][0-9][0-9AB]\\.?[0-9A-TV-Z]{0,4}$"
      },
      "semantic_grounding_rules": {
        "source_section": "SECTION 3: CLINICAL REFERRAL & ATTENDING PHYSICIAN",
        "verification_criteria": "Must extract the primary ICD-10 diagnosis code listed for the patient encounter. Must not substitute secondary, history, or rule-out diagnosis codes.",
        "failure_modes": [
          "SECONDARY_CODE_EXTRACTED_AS_PRIMARY",
          "INVALID_ICD_FORMAT",
          "HALLUCINATION"
        ]
      }
    }
  ]
}