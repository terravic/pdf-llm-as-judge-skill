{
  "rubric_version": "2.0",
  "document_type": "Cancer_Screening_Molecular_Diagnostic_Report",
  "extraction_criteria": [
    {
      "field_name": "patient_full_name",
      "syntactic_rules": {
        "required": true,
        "type": "string",
        "min_tokens": 2
      },
      "semantic_grounding_rules": {
        "source_section": "PATIENT IDENTIFICATION",
        "verification_criteria": "Must match the patient's legal name from the Patient Identification section. Do not extract preferred nicknames or clinician names.",
        "failure_modes": [
          "PREFERRED_NAME_CONFUSED_WITH_LEGAL",
          "NAME_TRUNCATED",
          "HALLUCINATION"
        ]
      }
    },
    {
      "field_name": "date_of_birth",
      "syntactic_rules": {
        "required": true,
        "type": "string",
        "format_regex": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "semantic_grounding_rules": {
        "source_section": "PATIENT IDENTIFICATION",
        "verification_criteria": "Must match the patient's date of birth in YYYY-MM-DD format. Must not be confused with specimen collection date, accession date, or report release date.",
        "failure_modes": [
          "CONFUSED_WITH_COLLECTION_DATE",
          "CONFUSED_WITH_REPORT_DATE",
          "FORMAT_MISMATCH"
        ]
      }
    },
    {
      "field_name": "medical_record_number",
      "syntactic_rules": {
        "required": true,
        "type": "string",
        "format_regex": "^MRN-\\d{7}$"
      },
      "semantic_grounding_rules": {
        "source_section": "PATIENT IDENTIFICATION",
        "verification_criteria": "Must extract the Medical Record Number (MRN). Must not be confused with specimen Accession ID, requisition numbers, or physician NPI.",
        "failure_modes": [
          "CONFUSED_WITH_ACCESSION_NUMBER",
          "CONFUSED_WITH_NPI",
          "DIGIT_TRANSPOSITION"
        ]
      }
    },
    {
      "field_name": "accession_id",
      "syntactic_rules": {
        "required": true,
        "type": "string",
        "format_regex": "^ACC-2026-MCED-\\d{4}$"
      },
      "semantic_grounding_rules": {
        "source_section": "SPECIMEN & ORDER INFORMATION",
        "verification_criteria": "Must extract the unique laboratory specimen accession identifier from the Specimen & Order Information section. Must not be confused with MRN or lab license numbers.",
        "failure_modes": [
          "CONFUSED_WITH_MRN",
          "FORMAT_MISMATCH",
          "HALLUCINATION"
        ]
      }
    },
    {
      "field_name": "ordering_physician",
      "syntactic_rules": {
        "required": true,
        "type": "string"
      },
      "semantic_grounding_rules": {
        "source_section": "SPECIMEN & ORDER INFORMATION",
        "verification_criteria": "Must extract the ordering clinician's name and credentials from the order section. Must not confuse with laboratory medical director or reviewing pathologist.",
        "failure_modes": [
          "LAB_DIRECTOR_CONFUSED_AS_ORDERING_PHYSICIAN",
          "PHYSICIAN_NAME_TRUNCATED",
          "NPI_CONFUSED_AS_NAME"
        ]
      }
    },
    {
      "field_name": "cancer_signal_status",
      "syntactic_rules": {
        "required": true,
        "type": "string",
        "enum_values": [
          "SIGNAL DETECTED",
          "NO SIGNAL DETECTED",
          "INDETERMINATE"
        ]
      },
      "semantic_grounding_rules": {
        "source_section": "OVERALL CANCER SIGNAL STATUS",
        "verification_criteria": "Must extract the primary overall cancer signal result classification as stated in the primary result banner.",
        "failure_modes": [
          "INCORRECT_CLASSIFICATION",
          "HALLUCINATION",
          "FORMAT_MISMATCH"
        ]
      }
    },
    {
      "field_name": "primary_cancer_signal_origin",
      "syntactic_rules": {
        "required": true,
        "type": "string"
      },
      "semantic_grounding_rules": {
        "source_section": "OVERALL CANCER SIGNAL STATUS",
        "verification_criteria": "Must extract the primary predicted tissue of origin (CSO 1) with highest probability. Must NOT extract secondary or lower-probability signal origins as primary.",
        "failure_modes": [
          "SECONDARY_ORIGIN_CONFUSED_AS_PRIMARY",
          "HALLUCINATION",
          "TEXT_TRUNCATION"
        ]
      }
    },
    {
      "field_name": "primary_origin_probability",
      "syntactic_rules": {
        "required": true,
        "type": "number",
        "value_range": {
          "min": 0.0,
          "max": 1.0
        }
      },
      "semantic_grounding_rules": {
        "source_section": "OVERALL CANCER SIGNAL STATUS",
        "verification_criteria": "Must extract the numeric prediction probability for the primary cancer signal origin as a decimal between 0.0 and 1.0 (convert percentage to decimal if necessary).",
        "failure_modes": [
          "SECONDARY_PROBABILITY_EXTRACTED",
          "PERCENTAGE_NOT_CONVERTED_TO_DECIMAL",
          "VALUE_TRANSPOSITION"
        ]
      }
    },
    {
      "field_name": "estimated_tumor_fraction_pct",
      "syntactic_rules": {
        "required": true,
        "type": "number",
        "value_range": {
          "min": 0.0,
          "max": 100.0
        }
      },
      "semantic_grounding_rules": {
        "source_section": "OVERALL CANCER SIGNAL STATUS",
        "verification_criteria": "Must extract the numeric estimated circulating tumor fraction percentage (ctDNA / cfDNA fraction) as a percentage number between 0.0 and 100.0.",
        "failure_modes": [
          "MUTATION_VAF_CONFUSED_AS_TUMOR_FRACTION",
          "DECIMAL_SHIFT",
          "HALLUCINATION"
        ]
      }
    },
    {
      "field_name": "detected_somatic_mutations",
      "syntactic_rules": {
        "required": true,
        "type": "array",
        "expected_subfields": [
          "gene",
          "variant",
          "exon",
          "vaf_pct",
          "tier"
        ]
      },
      "semantic_grounding_rules": {
        "source_section": "SECTION 1: TARGETED SOMATIC GENOMIC ALTERATIONS",
        "verification_criteria": "Must extract array of all detected pathogenic somatic mutations with gene symbol, variant notation, exon, variant allele fraction (VAF %), and clinical tier. Non-detected genes must not be included.",
        "failure_modes": [
          "MISSING_DETECTED_MUTATION",
          "NEGATIVE_MARKER_REPORTED_AS_POSITIVE",
          "VAF_TRANSPOSITION"
        ]
      }
    },
    {
      "field_name": "methylation_biomarkers",
      "syntactic_rules": {
        "required": true,
        "type": "object",
        "expected_subfields": [
          "sept9_index",
          "sdc2_index",
          "ndrg4_index"
        ]
      },
      "semantic_grounding_rules": {
        "source_section": "SECTION 2: EPIGENETIC METHYLATION PATTERNS & CIRCULATING PROTEIN MARKERS",
        "verification_criteria": "Must extract the epigenetic methylation biomarker score indexes for all target promoter regions from Section 2.",
        "failure_modes": [
          "CONFUSED_WITH_REFERENCE_BASELINE",
          "VALUE_TRANSPOSITION",
          "MISSING_BIOMARKER"
        ]
      }
    },
    {
      "field_name": "serum_carcinoembryonic_antigen_ng_ml",
      "syntactic_rules": {
        "required": true,
        "type": "number"
      },
      "semantic_grounding_rules": {
        "source_section": "SECTION 2: EPIGENETIC METHYLATION PATTERNS & CIRCULATING PROTEIN MARKERS",
        "verification_criteria": "Must extract the quantitative Serum Carcinoembryonic Antigen (CEA) protein marker value in ng/mL. Must NOT confuse with other protein markers or baseline reference limits.",
        "failure_modes": [
          "CONFUSED_WITH_CA_19_9",
          "CONFUSED_WITH_AFP",
          "UNITS_INCLUDED_IN_NUMERIC_FIELD"
        ]
      }
    }
  ]
}
